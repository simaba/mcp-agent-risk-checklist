{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Agent Risk Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "system_name", "scope", "review_status", "findings"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "system_name": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "review_status": {
      "type": "string",
      "enum": ["draft", "in_review", "approved_with_conditions", "blocked"]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "finding",
          "likelihood",
          "impact",
          "risk_level",
          "mitigation",
          "owner",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "area": {
            "type": "string",
            "enum": [
              "tool_scope",
              "permissions",
              "data_exposure",
              "prompt_injection",
              "auditability",
              "failure_modes",
              "human_oversight"
            ]
          },
          "finding": {"type": "string", "minLength": 1},
          "likelihood": {"type": "integer", "minimum": 1, "maximum": 5},
          "impact": {"type": "integer", "minimum": 1, "maximum": 5},
          "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "mitigation": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["open", "mitigating", "accepted", "blocked"]}
        }
      }
    }
  }
}
